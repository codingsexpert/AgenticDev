# -----------------------------------------------------------------------------
# AI Dev Team — Environment Configuration
# -----------------------------------------------------------------------------

# Gemini API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-3.6-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOKEN_BUDGET=2.0

# -----------------------------------------------------------------------------
# Supabase Configuration (Database & Authentication)
# -----------------------------------------------------------------------------
# Get from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# LangSmith Observability & Tracing Configuration (https://smith.langchain.com)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-dev-team
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
SANDBOX_DIR=sandboxes
USE_DOCKER_SANDBOX=true
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
